from __future__ import annotations

from fastapi import (
    APIRouter,
    Depends,
    HTTPException,
    Query,
    status,
)
from sqlalchemy import select
from sqlalchemy.orm import Session

from database.database import get_db

from schemas.client import (
    ClientCreate,
    ClientDashboardResponse,
    ClientListResponse,
    ClientResponse,
    ClientStatistics,
    ClientUpdate,
)

from services import client_service

from api.deps.current_user import get_current_company, get_current_user
from models.company import Company
from models.client import Client
from models.user import User

router = APIRouter(
    prefix="/clients",
    tags=["Clients"],
)

# ============================================================
# Authenticated Company Dependency
# ============================================================



MANAGE_CLIENT_ROLES = {"super_admin", "agency_admin", "manager"}


def require_client_management_access(
    current_user: User = Depends(get_current_user),
) -> User:
    """Only platform/admin agency roles may create or mutate clients."""
    if current_user.role not in MANAGE_CLIENT_ROLES:
        raise HTTPException(
            status_code=status.HTTP_403_FORBIDDEN,
            detail="Client management is available to agency administrators and Super Admin only.",
        )
    return current_user


def _get_owned_client(
    db: Session,
    current_user: User,
    company_id: str,
) -> Client:
    """Resolve the single client owned by a single-client account."""
    client = db.scalar(
        select(Client)
        .where(
            Client.company_id == company_id,
            Client.email == current_user.email,
        )
        .order_by(Client.created_at.asc())
    )
    if client is None:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="Your client workspace could not be resolved.",
        )
    return client


def require_client_scope(
    current_user: User = Depends(get_current_user),
) -> User:
    return current_user

def get_company_id(
    company: Company = Depends(get_current_company),
) -> str:
    """
    Resolve the company from the authenticated JWT user.
    """
    return str(company.id)


# ============================================================
# Get Clients
# ============================================================

@router.get(
    "/",
    response_model=list[ClientResponse],
)
def get_clients(
    skip: int = Query(default=0, ge=0),
    limit: int = Query(default=20, ge=1, le=100),
    db: Session = Depends(get_db),
    company_id: str = Depends(get_company_id),
    current_user: User = Depends(require_client_scope),
):

    if current_user.role == "client":
        owned = _get_owned_client(db, current_user, company_id)
        return [owned] if skip == 0 and limit > 0 else []

    return client_service.get_clients(
        db=db,
        company_id=company_id,
        skip=skip,
        limit=limit,
    )


# ============================================================
# Search Clients
# ============================================================

@router.get(
    "/search",
    response_model=ClientListResponse,
)
def search_clients(
    search: str | None = None,
    industry: str | None = None,
    country: str | None = None,
    city: str | None = None,
    status_filter: str | None = Query(
        default=None,
        alias="status",
    ),
    priority: str | None = None,
    page: int = Query(
        default=1,
        ge=1,
    ),
    page_size: int = Query(
        default=20,
        ge=1,
        le=100,
    ),
    sort_by: str = "business_name",
    sort_order: str = "asc",
    db: Session = Depends(get_db),
    company_id: str = Depends(get_company_id),
    current_user: User = Depends(require_client_scope),
):

    result = client_service.search_clients(
        db=db,
        company_id=company_id,
        search=search,
        industry=industry,
        country=country,
        city=city,
        status_filter=status_filter,
        priority=priority,
        page=page,
        page_size=page_size,
        sort_by=sort_by,
        sort_order=sort_order,
    )

    if current_user.role == "client":
        owned = _get_owned_client(db, current_user, company_id)
        items = [
            item for item in result.items
            if str(item.id) == str(owned.id)
        ]
        return result.model_copy(
            update={
                "total": len(items),
                "total_pages": 1 if items else 0,
                "items": items,
            }
        )

    return result


# ============================================================
# Client Statistics
# ============================================================

@router.get(
    "/statistics",
    response_model=ClientStatistics,
)
def get_statistics(
    db: Session = Depends(get_db),
    company_id: str = Depends(get_company_id),
    current_user: User = Depends(require_client_scope),
):

    if current_user.role == "client":
        raise HTTPException(
            status_code=status.HTTP_403_FORBIDDEN,
            detail="Agency-wide client statistics are not available to single-client accounts.",
        )

    return client_service.get_client_statistics(
        db=db,
        company_id=company_id,
    )


# ============================================================
# Client Dashboard
# ============================================================

@router.get(
    "/{client_id}/dashboard",
    response_model=ClientDashboardResponse,
)
def get_dashboard(
    client_id: str,
    db: Session = Depends(get_db),
    company_id: str = Depends(get_company_id),
    current_user: User = Depends(require_client_scope),
):

    if current_user.role == "client":
        owned = _get_owned_client(db, current_user, company_id)
        if str(owned.id) != str(client_id):
            raise HTTPException(status_code=403, detail="You can access only your own client.")

    return client_service.get_client_dashboard(
        db=db,
        company_id=company_id,
        client_id=client_id,
    )
    
    # ============================================================
# Create Client
# ============================================================

@router.post(
    "/",
    response_model=ClientResponse,
    status_code=201,
)
def create_client(
    client: ClientCreate,
    db: Session = Depends(get_db),
    company_id: str = Depends(get_company_id),
    current_user: User = Depends(require_client_management_access),
):
    """
    Create a new client.
    """

    return client_service.create_client(
        db=db,
        client=client,
        company_id=company_id,
    )


